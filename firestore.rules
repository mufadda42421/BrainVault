rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other users
      allow create, update: if isOwner(userId) && isValidId(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 256;
      allow delete: if isOwner(userId);

      // Notes subcollection
      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) &&
          request.resource.data.userId == userId &&
          request.resource.data.id == noteId &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 256;
        allow update: if isOwner(userId) && isValidId(noteId) &&
          request.resource.data.userId == userId &&
          request.resource.data.id == noteId;
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // Vault items subcollection
      match /vault_items/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(itemId) &&
          request.resource.data.userId == userId &&
          request.resource.data.id == itemId &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 256;
        allow update: if isOwner(userId) && isValidId(itemId) &&
          request.resource.data.userId == userId &&
          request.resource.data.id == itemId;
        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      // Collections subcollection
      match /collections/{collectionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(collectionId) &&
          request.resource.data.userId == userId &&
          request.resource.data.id == collectionId &&
          request.resource.data.name is string &&
          request.resource.data.name.size() <= 128;
        allow update: if isOwner(userId) && isValidId(collectionId) &&
          request.resource.data.userId == userId &&
          request.resource.data.id == collectionId;
        allow delete: if isOwner(userId) && isValidId(collectionId);
      }

      // Journal subcollection
      match /journals/{journalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(journalId) &&
          request.resource.data.userId == userId &&
          request.resource.data.id == journalId &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 256;
        allow update: if isOwner(userId) && isValidId(journalId) &&
          request.resource.data.userId == userId &&
          request.resource.data.id == journalId;
        allow delete: if isOwner(userId) && isValidId(journalId);
      }
    }
  }
}
