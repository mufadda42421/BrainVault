{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "theme": { "type": "string", "enum": ["dark", "light", "system"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email"]
    },
    "Note": {
      "title": "Note",
      "description": "Personal note document with rich text content, tags, and organization",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "content": { "type": "string", "maxLength": 100000 },
        "category": { "type": "string", "maxLength": 64 },
        "tags": { "type": "array" },
        "isPinned": { "type": "boolean" },
        "isFavorite": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "folderId": { "type": "string", "maxLength": 128 },
        "attachments": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title"]
    },
    "VaultItem": {
      "title": "VaultItem",
      "description": "Saved item in knowledge vault such as web bookmarks, articles, ideas, or media",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["url", "article", "youtube", "image", "pdf", "document", "idea", "research"] },
        "title": { "type": "string", "maxLength": 256 },
        "url": { "type": "string", "maxLength": 2048 },
        "description": { "type": "string", "maxLength": 5000 },
        "content": { "type": "string", "maxLength": 50000 },
        "category": { "type": "string", "maxLength": 64 },
        "tags": { "type": "array" },
        "isFavorite": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "type", "title"]
    },
    "Collection": {
      "title": "Collection",
      "description": "Custom folder or collection for organizing notes and vault items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1000 },
        "icon": { "type": "string", "maxLength": 64 },
        "color": { "type": "string", "maxLength": 64 },
        "itemCount": { "type": "integer" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name"]
    },
    "Journal": {
      "title": "Journal",
      "description": "Daily reflection entry with mood, prompts, and thoughts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 256 },
        "content": { "type": "string", "maxLength": 50000 },
        "mood": { "type": "string", "maxLength": 32 },
        "reflectionPrompt": { "type": "string", "maxLength": 500 },
        "tags": { "type": "array" },
        "isPrivate": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "date", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile information"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "User notes with rich text content, tags, and organization"
    },
    "/users/{userId}/vault_items/{itemId}": {
      "schema": "VaultItem",
      "description": "Saved items in knowledge vault (URLs, articles, ideas, media, research)"
    },
    "/users/{userId}/collections/{collectionId}": {
      "schema": "Collection",
      "description": "User custom folders and collections"
    },
    "/users/{userId}/journals/{journalId}": {
      "schema": "Journal",
      "description": "Daily journal entries and reflections"
    }
  }
}
